{
  "name": "sentinel-stack",
  "version": "0.1.0",
  "description": "Reference deployment for the Sentinel climate-health stack: one composed server, one Postgres, a synthetic seed scenario, and a minimal dashboard.",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,scripts}/**/*.ts\" --fix",
    "db:push:ehr-bridge": "cd ../ehr-bridge && yarn db:push",
    "db:push:sentinel": "cd ../sentinel && yarn db:push",
    "db:push": "yarn db:push:ehr-bridge && yarn db:push:sentinel",
    "scenario": "ts-node scripts/run-scenario.ts"
  },
  "dependencies": {
    "@ehr-bridge/sdk": "file:../ehr-bridge-sdk",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-fastify": "^11.1.19",
    "@fastify/static": "^8.0.4",
    "ehr-bridge": "file:../ehr-bridge",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sentinel": "file:../sentinel"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
