# Copy to .env and fill in. docker-compose.yml provides working defaults for
# every one of these, so `docker compose up` runs with zero configuration.

PORT=3000
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel_stack

# ehr-bridge admin API — see ehr-bridge/.env.example for what these guard.
ADMIN_API_KEY=dev-admin-key-change-me
ADMIN_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PATIENT_IDENTIFIER_SYSTEM=urn:ehr-bridge:source-patient-id

# sentinel inference backend: mock | http
INFERENCE_BACKEND=mock
MODEL_API_URL=
MODEL_API_KEY=

# Africa's Talking SMS — leave AT_API_KEY unset to use the mock adapter.
AT_API_KEY=
AT_USERNAME=sandbox
